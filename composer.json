{
    "name": "uiuclibrary/teams",
    "description": "Omeka S module for team-based resource visibility and permission management",
    "type": "omeka-module",
    "license": "Apache-2.0",
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Teams\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Teams\\Tests\\": "tests/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    }
}
