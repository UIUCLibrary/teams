    'team-resources' => $translate('Resources'),
    'team-secondary-resources' => $translate('Other Resources'),
    'team-sites' => $translate('Sites'),
];
?>
<?php echo $this->pageTitle($this->teamRepresentation->name(), 1, $translate('Teams'), $translate('Edit')); ?>
<?php $this->trigger('view.edit.before'); ?>

<?php echo $this->sectionNav($sectionNavs, 'view.edit.section_nav'); ?>

<div id="page-actions">
    <?php echo $this->cancelButton(); ?>
