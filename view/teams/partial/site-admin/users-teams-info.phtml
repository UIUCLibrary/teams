<?php
/**
 * Annotates the Omeka site admin user-permissions table with the team that
 * granted each user their site role.
 *
 * Variables:
 *   $this->teamManagedUsers  array  userId (int) => array of team names (string[])
 */
$teamManagedUsers = $this->teamManagedUsers;
$translate = $this->plugin('translate');

if (empty($teamManagedUsers)) {
    return;
}
?>
<div class="teams-permissions-info" style="margin-top:1.5em;">
    <h3><?php echo $translate('Team-Managed User Permissions'); ?></h3>
    <p><?php echo $translate('The following users have site roles granted by the Teams module. The column shows which team(s) are responsible.'); ?></p>
    <table>
        <thead>
            <tr>
                <th><?php echo $translate('User ID'); ?></th>
                <th><?php echo $translate('Granting Team(s)'); ?></th>
            </tr>
        </thead>
        <tbody>
        <?php foreach ($teamManagedUsers as $userId => $teams): ?>
            <tr>
                <td><?php echo (int) $userId; ?></td>
                <td><?php echo $this->escapeHtml(implode(', ', $teams)); ?></td>
            </tr>
        <?php endforeach; ?>
        </tbody>
    </table>
</div>
